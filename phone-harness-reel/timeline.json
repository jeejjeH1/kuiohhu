 "lines": [
  {
   "i": 0,
   "scene": "hook",
   "start": 0.35,
   "end": 7.377,
   "text": "به هوش مصنوعی بگی «برام یه تاکسی بگیر»… و خودش با گوشی واقعیت این کار رو بکنه!",
   "voice": true
  },
  {
   "i": 1,
   "scene": "reveal",
   "start": 8.277,
   "end": 14.024,
   "text": "این، phone-harness؛ رایگان و متن‌باز، برای Claude Code، Codex و هر ایجنتی.",
   "voice": true
  },
  {
   "i": 2,
   "scene": "abilities",
   "start": 14.924,
   "end": 19.548,
   "text": "اسکرول می‌کنه، تپ می‌کنه، تایپ می‌کنه و صفحه رو می‌خونه.",
   "voice": true
  },
  {
   "i": 3,
   "scene": "noinstall",
   "start": 20.448,
   "end": 25.698,
   "text": "بدون جیلبریک، بدون Xcode و بدون نصب حتی یک برنامه روی گوشی.",
   "voice": true
  },
  {
   "i": 4,
   "scene": "demo",
   "start": 26.598,
   "end": 34.357,
   "text": "توی این دموی واقعی، Claude خودش اپ Waymo رو باز کرد، مقصد رو پیدا کرد و قبل از رزرو از کاربر تأیید گرفت.",
   "voice": true
  },
  {
   "i": 5,
   "scene": "platforms",
   "start": 37.098,
   "end": 42.662,
   "text": "آیفون، اندروید و حتی گوشی‌های ابری؛ یه اسکریپت، روی همه‌شون اجرا می‌شه.",
   "voice": true
  },
  {
   "i": 6,
   "scene": "setup",
   "start": 43.562,
   "end": 49.44,
   "text": "نصبش هم فقط یه پرامپته؛ ایجنتت خودش نصبش می‌کنه و قدم‌به‌قدم راهنماییت می‌کنه.",
   "voice": true
  },
  {
   "i": 7,
   "scene": "cta",
   "start": 50.34,
   "end": 55.904,
   "text": "برای دریافت لینک و پرامپت نصب، کلمه‌ی «میخوام» رو کامنت کنید تا براتون بفرستم.",
   "voice": true
  }
 ]
