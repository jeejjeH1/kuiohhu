{
  "manifest_version": 3,
  "name": "X Auto Liker",
  "version": "7.12.0",
  "description": "جعبه‌ابزار فارسی X: لایک نوبتی، کامنت هوشمند، فونت فارسی، دانلود، عکس از توییت، پوشه‌بندی، قالب متن، آمار و مدیریت دنبال‌شوندگان.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://openrouter.ai/*",
    "https://api.sorsa.io/*",
    "https://app.sorsa.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content/media-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "i18n-dict.js",
        "i18n.js",
        "content/common.js",
        "content/persian.js",
        "content/tweet-tools.js",
        "content/card.js",
        "content/composer.js",
        "content/analytics-collect.js",
        "content/audit-rules.js",
        "content/audit.js",
        "content/sync.js",
        "content/comments.js",
        "content/translate.js",
        "content/audience.js",
        "content/mentions.js",
        "content/sorsa.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.sorsa.io/*"
      ],
      "js": [
        "content/sorsa-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ]
    }
  ],
  "commands": {
    "next-link": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "حالت دستی: رفتن به لینک بعدی"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Auto Liker"
  }
}
